# Optional environment overrides for docker compose.
# Copy to .env only if you need to change the defaults.
# These names match what docker-compose.yml and the daemon/UI actually read.

# Daemon API port (default: 3000)
SIGNET_PORT=3000

# Daemon bind address (default: 0.0.0.0). For a private deployment, consider
# binding to loopback or your Tailscale address instead of all interfaces.
SIGNET_HOST=0.0.0.0

# Web UI port (default: 4174)
UI_PORT=4174

# Web UI bind address (default: 0.0.0.0)
UI_HOST=0.0.0.0

# URL the UI server uses to reach the daemon (default: http://signet:3000 in compose)
DAEMON_URL=http://signet:3000

# Public base URL used for NIP-46 authorization callbacks (default: http://localhost:4174)
EXTERNAL_URL=http://localhost:4174

# SQLite database location (default: file:/app/config/signet.db)
DATABASE_URL=file:/app/config/signet.db
